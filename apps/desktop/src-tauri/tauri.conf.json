{
  "productName": "WePLD",
  "version": "0.0.0",
  "identifier": "com.wepld.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WePLD",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; script-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/wepld-core"
    ]
  }
}
